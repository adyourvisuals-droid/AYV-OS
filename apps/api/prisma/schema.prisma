model Attendance {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  date        DateTime
  checkInAt   DateTime?
  checkOutAt  DateTime?
  status      AttendanceStatus @default(PRESENT)
  workMinutes Int?
  lateMinutes Int?
  checkInIp   String?
  location    Json?
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([organizationId, date])
}

model Leave {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  type      LeaveType
  status    LeaveStatus @default(PENDING)
  startDate DateTime
  endDate   DateTime
  days      Decimal     @db.Decimal(4, 1)
  reason    String?

  approverId String?
  decidedAt  DateTime?
  decisionNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver     User?        @relation("LeaveApprover", fields: [approverId], references: [id])

  @@index([organizationId, status])
  @@index([userId, startDate])
}

model LeaveBalance {
  id     String    @id @default(cuid())
  userId String
  year   Int
  type   LeaveType
  entitled Decimal @default(0) @db.Decimal(4, 1)
  used     Decimal @default(0) @db.Decimal(4, 1)

  updatedAt DateTime @updatedAt

  @@unique([userId, year, type])
}

model Payroll {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  month Int
  year  Int

  basic       Decimal @default(0) @db.Decimal(14, 2)
  allowances  Decimal @default(0) @db.Decimal(14, 2)
  deductions  Decimal @default(0) @db.Decimal(14, 2)
  bonus       Decimal @default(0) @db.Decimal(14, 2)
  netPay      Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("INR")

  presentDays Decimal? @db.Decimal(4, 1)
  status      String   @default("DRAFT")
  approvedById String?
  paidAt      DateTime?
  payslipUrl  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, month, year])
  @@index([organizationId, year, month])
}

model PerformanceReview {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  reviewerId     String?

  periodLabel String
  periodStart DateTime
  periodEnd   DateTime

  /// 1–5.
  overallRating Decimal? @db.Decimal(3, 2)
  strengths     String?
  improvements  String?
  managerNotes  String?
  status        String   @default("DRAFT")
  submittedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  goals Goal[]

  @@index([organizationId, userId])
}

model Goal {
  id       String @id @default(cuid())
  reviewId String?
  userId   String
  title    String
  description String?
  /// KRA the goal rolls up to.
  kra      String?
  target   String?
  progress Int      @default(0)
  dueDate  DateTime?
  status   String   @default("ACTIVE")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  review PerformanceReview? @relation(fields: [reviewId], references: [id])

  @@index([userId])
}

model JobOpening {
  id             String @id @default(cuid())
  organizationId String

  title       String
  department  String?
  description String?
  location    String?
  employmentType String?
  status      String  @default("OPEN")
  openings    Int     @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  candidates Candidate[]

  @@index([organizationId, status])
}

model Candidate {
  id           String @id @default(cuid())
  jobOpeningId String

  name       String
  email      String?
  phone      String?
  resumeUrl  String?
  stage      CandidateStage @default(APPLIED)
  /// AI screening score against the job description, 0–100.
  score      Int?
  screeningNotes String?
  rejectionReason String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

  @@index([jobOpeningId, stage])
}

