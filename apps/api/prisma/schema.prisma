// ═══════════════════════════════════════════════════════════════════════════
//  AYV OS — Database Schema
//  PostgreSQL 16 · Prisma
//
//  Conventions (see docs/02-database-schema.md):
//    • every business table carries organizationId — tenant isolation is
//      enforced by Prisma middleware, never by developer discipline
//    • deletedAt is soft delete; reads filter it out automatically
//    • money is Decimal(14,2), never Float
//    • createdById attributes the actor on every row
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
//  ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum UserType {
  EMPLOYEE
  CLIENT
  AI_AGENT
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  OFFBOARDED
}

enum PermissionScope {
