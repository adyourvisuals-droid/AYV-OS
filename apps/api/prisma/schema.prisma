  isPublished Boolean @default(false)
  steps       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, deletedAt])
}

model RecurringTask {
  id             String @id @default(cuid())
  organizationId String

  title      String
  /// Standard cron expression, evaluated in the organisation's timezone.
  cron       String
  projectId  String?
  assigneeId String?
  priority   Priority @default(MEDIUM)
  isActive   Boolean  @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, isActive])
  @@index([nextRunAt])
}

model KnowledgeArticle {
  id             String @id @default(cuid())
  organizationId String

  title       String
  slug        String
  category    String?
  content     String
  tags        String[]
  isPublished Boolean  @default(false)
  /// Roles permitted to read. Empty means everyone in the organisation.
  visibleToRoles String[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@index([organizationId, category])
}

model DocumentTemplate {
  id             String @id @default(cuid())
  organizationId String

  /// PROPOSAL · INVOICE · QUOTATION · AGREEMENT · NDA · OFFER_LETTER · …
  type      String
  name      String
  content   String
  variables Json?
  isDefault Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId, type])
}

model AssetFolder {
  id             String @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  clientId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   AssetFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children AssetFolder[] @relation("FolderTree")
  assets   Asset[]

  @@index([organizationId, parentId])
}

model Asset {
  id             String @id @default(cuid())
  organizationId String

  name      String
  folderId  String?
  clientId  String?
  projectId String?

  fileKey   String
  fileUrl   String?
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  durationSeconds Int?

  tags          String[]
  version       Int     @default(1)
  isAiGenerated Boolean @default(false)
  uploadedById  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder       AssetFolder?   @relation(fields: [folderId], references: [id])
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  versions     AssetVersion[]

  @@index([organizationId, deletedAt])
  @@index([folderId])
  @@index([clientId])
}

model AssetVersion {
  id      String @id @default(cuid())
  assetId String
  version Int
  fileKey String
  sizeBytes Int
  note    String?
  createdById String?

  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
}

model SocialPost {
  id             String @id @default(cuid())
  organizationId String

  clientId  String?
  campaignId String?
  authorId  String?

  platforms SocialPlatform[]
  caption   String?
  hashtags  String[]
  mediaUrls String[]
  status    PostStatus @default(DRAFT)

  scheduledAt DateTime?
  publishedAt DateTime?
  failureReason String?
  externalIds Json?

  /// Synced from the platform after publishing.
  reach       Int?
  impressions Int?
  engagement  Int?
  clicks      Int?

  isAiGenerated Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  author       User?        @relation("PostAuthor", fields: [authorId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id])

  @@index([organizationId, status, scheduledAt])
  @@index([clientId])
}

model Campaign {
  id             String @id @default(cuid())
  organizationId String

  name      String
  clientId  String?
  platform  String?
  objective String?
  status    String  @default("DRAFT")

  startDate DateTime?
  endDate   DateTime?
  budget    Decimal? @db.Decimal(14, 2)
  spend     Decimal  @default(0) @db.Decimal(14, 2)
  currency  String   @default("INR")

  impressions Int?
  clicks      Int?
  conversions Int?
  revenue     Decimal? @db.Decimal(14, 2)
  roas        Decimal? @db.Decimal(8, 2)

  externalId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  posts SocialPost[]

  @@index([organizationId, status])
  @@index([clientId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  AUTOMATION · AI · ANALYTICS
// ═══════════════════════════════════════════════════════════════════════════

model AutomationRule {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String?
  isActive    Boolean @default(false)

  /// 'EVENT' · 'SCHEDULE' · 'THRESHOLD' · 'MANUAL' · 'WEBHOOK'
  triggerType String
  /// e.g. 'lead.created'; or a cron expression for SCHEDULE triggers.
  triggerKey  String
  /// Nested AND/OR condition groups.
  conditions  Json    @default("[]")
  /// Ordered action list.
  actions     Json    @default("[]")

  runCount    Int       @default(0)
  lastRunAt   DateTime?
  lastError   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         AutomationRun[]

  @@index([organizationId, isActive, triggerKey])
}

model AutomationRun {
  id     String @id @default(cuid())
  ruleId String

  status     AutomationRunStatus
  triggerData Json?
  actionResults Json?
  error      String?
  durationMs Int?
  /// Chain depth, capped at 10 to prevent runaway cascades.
  depth      Int @default(0)

  createdAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

model AiAgent {
  id             String @id @default(cuid())
  organizationId String

  /// SALES · MARKETING · DESIGN · COPY · PROJECT · HR · FINANCE · LEGAL ·
  /// MEETING · SUPPORT · CEO
  key         String
  name        String
  description String?
  isActive    Boolean       @default(true)
  autonomy    AgentAutonomy @default(SUGGEST)

  /// The RBAC role this agent acts under. Tool calls are checked against it
  /// exactly as a human request would be.
  roleId       String?
  model        String  @default("claude-opus-5")
  fallbackModel String?
  systemPrompt String
  promptVersion Int    @default(1)
  tools        String[]

  costCapDailyUsd Decimal @default(10) @db.Decimal(8, 2)
  costTodayUsd    Decimal @default(0) @db.Decimal(8, 2)
  costResetAt     DateTime?

  // Performance record — the evidence base for promoting autonomy.
  invocationCount Int      @default(0)
  acceptedCount   Int      @default(0)
  rejectedCount   Int      @default(0)
  errorCount      Int      @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations AiConversation[]
  memories      AiMemory[]

  @@unique([organizationId, key])
  @@index([organizationId, isActive])
}

model AiConversation {
  id             String @id @default(cuid())
  organizationId String
  agentId        String?
  userId         String

  title       String?
  /// The record the conversation is anchored to, if any.
  contextType String?
  contextId   String?

  totalTokens Int     @default(0)
  totalCostUsd Decimal @default(0) @db.Decimal(10, 4)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  agent    AiAgent?    @relation(fields: [agentId], references: [id])
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([organizationId, userId])
}

model AiMessage {
  id             String @id @default(cuid())
  conversationId String

  role    String // 'user' | 'assistant' | 'system' | 'tool'
  content String
  toolCalls Json?
  toolResults Json?

  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal? @db.Decimal(10, 6)
  model        String?
  latencyMs    Int?

  createdAt DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Long-term agent memory.
///
/// `embedding` is Float[] in Phase 1 so the schema pushes to a stock Postgres
/// image. Phase 4 migrates it to pgvector `vector(1536)` with an IVFFlat index
/// — see docs/02-database-schema.md §5.
model AiMemory {
  id             String @id @default(cuid())
  organizationId String
  agentId        String?

  /// 'EPISODIC' | 'SEMANTIC' | 'CORRECTION'
  memoryType String
  content    String
  embedding  Float[]
  /// 0–1. Corrections from humans are stored at high importance so the agent
  /// retrieves them first.
  importance Decimal @default(0.5) @db.Decimal(3, 2)

  contextType String?
  contextId   String?
  accessCount Int      @default(0)
  lastAccessedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  agent AiAgent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([organizationId, agentId, memoryType])
  @@index([contextType, contextId])
}

/// Precomputed metrics. The Executive Dashboard reads almost entirely from
/// this table — dashboards must not aggregate hot OLTP tables at request time.
model AnalyticsSnapshot {
  id             String @id @default(cuid())
  organizationId String

  /// 'revenue' · 'mrr' · 'profit' · 'pipeline_value' · 'utilisation' · …
  metric         String
  /// 'total' · 'client' · 'service' · 'employee' · 'source'
  dimension      String  @default("total")
  dimensionValue String  @default("all")

  period      SnapshotPeriod
  periodStart DateTime
  periodEnd   DateTime

  value     Decimal @db.Decimal(16, 4)
  count     Int?
  breakdown Json?

  computedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metric, dimension, dimensionValue, period, periodStart])
  @@index([organizationId, metric, period, periodStart])
}

model KpiTarget {
  id             String @id @default(cuid())
  organizationId String

  metric   String
  scope    String  @default("ORG") // ORG · TEAM · USER
  scopeId  String?
  period   SnapshotPeriod
  periodStart DateTime
  target   Decimal @db.Decimal(16, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, metric, scope, scopeId, periodStart])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PLATFORM — notifications, audit, integrations
// ═══════════════════════════════════════════════════════════════════════════

model Notification {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  type     String
  title    String
  body     String?
  /// In-app deep link.
  link     String?
  severity String  @default("INFO")

  entityType String?
  entityId   String?

  channels NotificationChannel[] @default([IN_APP])
  readAt   DateTime?
  sentAt   DateTime?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([organizationId])
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String
  /// Notification type key, or '*' for the default.
  type   String

  inApp    Boolean @default(true)
  email    Boolean @default(true)
  whatsapp Boolean @default(false)
  push     Boolean @default(true)

  /// Suppress non-critical notifications outside working hours.
  quietHoursStart String?
  quietHoursEnd   String?

  updatedAt DateTime @updatedAt

  @@unique([userId, type])
}

/// Append-only. Never updated, never deleted.
model AuditLog {
  id             String @id @default(cuid())
  organizationId String

  actorId   String?
  actorType ActorType @default(USER)
  /// Set when actorType is AI_AGENT — machine actions stay attributable.
  agentKey  String?

  action   String // CREATE · UPDATE · DELETE · RESTORE · LOGIN · APPROVE · …
  entity   String
  entityId String?

  before Json?
  after  Json?
  /// Field names that changed. Cheap filter before diffing the JSON blobs.
  changedFields String[]

  ipAddress String?
  userAgent String?
  requestId String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model Integration {
  id             String @id @default(cuid())
  organizationId String

  /// 'meta' · 'google_ads' · 'ga4' · 'whatsapp' · 'razorpay' · 'google_drive'
  provider    String
  displayName String?
  isActive    Boolean @default(true)

  /// Encrypted at rest by the application layer before persisting.
  credentials Json?
  config      Json?
  accountId   String?

  lastSyncAt    DateTime?
  lastSyncError String?
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, accountId])
  @@index([organizationId, isActive])
}
