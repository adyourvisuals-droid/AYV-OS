// ═══════════════════════════════════════════════════════════════════════════
//  CORE — organisation, identity, access control
// ═══════════════════════════════════════════════════════════════════════════

model Organization {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  legalName    String?
  logoUrl      String?
  website      String?
  email        String?
  phone        String?

  // Address
  addressLine1 String?
  addressLine2 String?
  city         String?
  state         String?
  stateCode     String? // drives CGST/SGST vs IGST determination
  country       String  @default("India")
  postalCode    String?

  // Commercial
  gstNumber     String?
  panNumber     String?

  // Bank details — printed on invoices/quotations/contracts for payment
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfscCode      String?
  bankUpiId         String?

  currency      String  @default("INR")
  timezone      String  @default("Asia/Kolkata")
  locale        String  @default("en-IN")
  fiscalYearStartMonth Int @default(4) // April, Indian FY

  // Working pattern — drives attendance and SLA calculations
  workingDays   Int[]   @default([1, 2, 3, 4, 5, 6])
  workDayStart  String  @default("10:00")
  workDayEnd    String  @default("19:00")

  settings      Json    @default("{}")
  featureFlags  Json    @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users              User[]
  roles              Role[]
  teams              Team[]
  leads              Lead[]
  clients            Client[]
  projects           Project[]
  tasks              Task[]
  activities         Activity[]
  invoices           Invoice[]
  expenses           Expense[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  analyticsSnapshots AnalyticsSnapshot[]
  automationRules    AutomationRule[]
  aiAgents           AiAgent[]
  assets             Asset[]
  creativeBriefs     CreativeBrief[]
  approvals          Approval[]
  attendances        Attendance[]
  leaves             Leave[]
  socialPosts        SocialPost[]
  tickets            Ticket[]
  knowledgeArticles  KnowledgeArticle[]
  integrations       Integration[]

  @@index([deletedAt])
}

model User {
  id             String @id @default(cuid())
  organizationId String

  email        String
  passwordHash String?
  name         String
  phone        String?
  avatarUrl    String?

  userType UserType   @default(EMPLOYEE)
  status   UserStatus @default(ACTIVE)

  roleId String
  teamId String?

  /// Set only for userType=CLIENT. Hard-scopes every query the user makes.
  clientId String?

  // Employment
  designation String?
  department  String?
  joinedAt    DateTime?
  managerId   String?

  /// Redacted from the API for all but SUPER_ADMIN, CEO, HR and FINANCE.
  salary   Decimal? @db.Decimal(14, 2)

  // Preferences
  theme       String @default("system")
  preferences Json   @default("{}")

  // Security
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  lastLoginAt    DateTime?
  lastActiveAt   DateTime?
  passwordChangedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])
  client       Client?      @relation("ClientPortalUsers", fields: [clientId], references: [id])
  manager      User?        @relation("Reports", fields: [managerId], references: [id])
  reports      User[]       @relation("Reports")

  sessions        Session[]
  userPermissions UserPermission[]

  ownedLeads      Lead[]     @relation("LeadOwner")
  managedClients  Client[]   @relation("AccountManager")
  managedProjects Project[]  @relation("ProjectManager")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]     @relation("TaskAssignee")
  taskComments    TaskComment[]
  timeLogs        TimeLog[]
  activities      Activity[] @relation("ActivityActor")
  auditLogs       AuditLog[]
  notifications   Notification[]
  attendances     Attendance[]
  leaves          Leave[]           @relation("LeaveRequester")
  approvedLeaves  Leave[]           @relation("LeaveApprover")
  expenses        Expense[]         @relation("ExpenseSubmitter")
  approvals       Approval[]        @relation("ApprovalDecider")
  creativeBriefs  CreativeBrief[]   @relation("CreativeAssignee")
  aiConversations AiConversation[]
  assets          Asset[]
  socialPosts     SocialPost[]      @relation("PostAuthor")
  tickets         Ticket[]          @relation("TicketAssignee")

  @@unique([organizationId, email])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([roleId])
  @@index([teamId])
  @@index([clientId])
  @@index([managerId])
}

model Role {
  id             String  @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  /// System roles cannot be edited or deleted — protects against lockout.
  isSystem       Boolean @default(false)
  /// Lower number = more senior. Drives escalation ladders.
  level          Int     @default(100)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  permissions  RolePermission[]

  @@unique([organizationId, key])
  @@index([organizationId, deletedAt])
}

model Permission {
  id          String  @id @default(cuid())
  /// `resource:action`, e.g. `crm:lead:read`
  key         String  @unique
  domain      String
  description String?

  roles RolePermission[]
  users UserPermission[]

  @@index([domain])
}

model RolePermission {
  id           String          @id @default(cuid())
  roleId       String
  permissionId String
  scope        PermissionScope @default(ALL)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

/// Per-user grant/deny overrides. Evaluated before role permissions;
/// a DENY here beats every grant anywhere else.
model UserPermission {
  id           String          @id @default(cuid())
  userId       String
  permissionId String
  scope        PermissionScope @default(ALL)
  granted      Boolean         @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
}

model Team {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  leadId         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      User[]

  @@unique([organizationId, name])
  @@index([organizationId, deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  /// SHA-256 of the refresh token. The raw token is never stored.
  refreshTokenHash String
  /// Groups rotated tokens so reuse detection can revoke the whole chain.
  familyId     String
  userAgent    String?
  ipAddress    String?
  deviceLabel  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([refreshTokenHash])
}

/// Defines a custom field on one of the fixed entity types below. The value
/// itself lives in that entity's own `customFields` Json column, keyed by
/// `key` — this table is schema metadata, not data.
model CustomFieldDefinition {
  id             String @id @default(cuid())
  organizationId String

  /// 'Lead' · 'Client' · 'Project' · 'Task'
  entityType String
  /// Stable machine key used inside the target row's customFields Json.
  key        String
  label      String
  /// 'TEXT' · 'NUMBER' · 'DATE' · 'BOOLEAN' · 'SELECT'
  fieldType  String
  /// Only meaningful when fieldType is 'SELECT'.
  options    String[]
  required   Boolean  @default(false)
  position   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, entityType, key])
  @@index([organizationId, entityType])
}

// ═══════════════════════════════════════════════════════════════════════════
//  CRM
// ═══════════════════════════════════════════════════════════════════════════

model Lead {
  id             String @id @default(cuid())
  organizationId String

  name        String
  contactName String?
  email       String?
  phone       String?
  company     String?
  city        String?

  source     LeadSource  @default(MANUAL)
  sourceMeta Json?
  status     LeadStatus  @default(NEW)
  temperature Temperature @default(WARM)
  industry   Industry?
  services   ServiceType[]

  estimatedValue Decimal @default(0) @db.Decimal(14, 2)
  currency       String  @default("INR")

  /// AI qualification score, 0–100.
  score            Int      @default(0)
  /// AI close-probability, 0–1. Null until the first scoring run.
  closeProbability Decimal? @db.Decimal(4, 3)

  notes      String?
  lostReason String?
  winReason  String?

  /// Values keyed by CustomFieldDefinition.key for entityType 'Lead'.
  customFields Json @default("{}")

  ownerId String?

  /// Preserved after conversion — a client's sales history is never lost.
  convertedClientId String?   @unique
  convertedAt       DateTime?

  stageChangedAt DateTime  @default(now())
  lastActivityAt DateTime?
  nextFollowUpAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  convertedClient Client?      @relation("ConvertedFromLead", fields: [convertedClientId], references: [id])

  activities  Activity[]
  quotations  Quotation[]
  stageEvents LeadStageEvent[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status, ownerId])
  @@index([organizationId, temperature])
  @@index([organizationId, source])
  @@index([ownerId])
  @@index([nextFollowUpAt])
}

/// One row per stage transition. Backs stage-velocity analytics without
/// having to reconstruct history from the audit log.
model LeadStageEvent {
  id        String     @id @default(cuid())
  leadId    String
  fromStage LeadStatus?
  toStage   LeadStatus
  /// Time spent in the previous stage.
  durationHours Int?
  actorId   String?
  createdAt DateTime   @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Activity {
  id             String @id @default(cuid())
  organizationId String

  type    ActivityType
  title   String
  body    String?
  outcome String?

  occurredAt      DateTime  @default(now())
  durationMinutes Int?

  leadId    String?
  clientId  String?
  projectId String?
  actorId   String?

  isAiGenerated Boolean @default(false)
  metadata      Json?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User?        @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([organizationId, deletedAt])
  @@index([leadId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([projectId, occurredAt])
}

model Quotation {
  id             String @id @default(cuid())
  organizationId String

  number   String
  leadId   String?
  clientId String?

  status     String   @default("DRAFT")
  validUntil DateTime?

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(14, 2)
  taxRate   Decimal @default(18) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)
  currency  String  @default("INR")

  terms  String?
  notes  String?
  sentAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  lead   Lead?           @relation(fields: [leadId], references: [id])
  client Client?         @relation(fields: [clientId], references: [id])
  items  QuotationItem[]

  @@unique([organizationId, number])
  @@index([organizationId, deletedAt])
  @@index([leadId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  service     ServiceType?
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)
  position    Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Contract {
  id             String @id @default(cuid())
  organizationId String

  number   String
  title    String
  clientId String?
  leadId   String?

  status       String    @default("DRAFT")
  value        Decimal   @default(0) @db.Decimal(14, 2)
  currency     String    @default("INR")
  startDate    DateTime?
  endDate      DateTime?
  noticePeriodDays Int?
  signedAt     DateTime?
  signedByName String?
  documentUrl  String?
  terms        Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  client Client? @relation(fields: [clientId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, deletedAt])
  @@index([clientId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  CLIENTS
// ═══════════════════════════════════════════════════════════════════════════

model Client {
  id             String @id @default(cuid())
  organizationId String

  name      String
  legalName String?
  logoUrl   String?
  industry  Industry?
  status    ClientStatus @default(ONBOARDING)

  email   String?
  phone   String?
  website String?

  addressLine1 String?
  city         String?
  state        String?
  stateCode    String? // vs Organization.stateCode → CGST/SGST or IGST
  country      String  @default("India")
  postalCode   String?
  gstNumber    String?

  services        ServiceType[]
  monthlyRetainer Decimal?     @db.Decimal(14, 2)
  currency        String       @default("INR")

  /// Denormalised for fast list rendering. Full breakdown lives in
  /// ClientHealthSnapshot, written nightly.
  healthScore     Int @default(70)
  healthUpdatedAt DateTime?

  accountManagerId String?

  contractStartDate DateTime?
  renewalDate       DateTime?

  /// Never exposed to the CLIENT role.
  internalNotes String?

  /// Values keyed by CustomFieldDefinition.key for entityType 'Client'.
  customFields Json @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountManager User?        @relation("AccountManager", fields: [accountManagerId], references: [id])

  originLead      Lead?  @relation("ConvertedFromLead")
  portalUsers     User[] @relation("ClientPortalUsers")
  contacts        ClientContact[]
  healthSnapshots ClientHealthSnapshot[]
  projects        Project[]
  invoices        Invoice[]
  activities      Activity[]
  quotations      Quotation[]
  contracts       Contract[]
  tickets         Ticket[]
  socialPosts     SocialPost[]
  creativeBriefs  CreativeBrief[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([accountManagerId])
  @@index([renewalDate])
}

model ClientContact {
  id       String  @id @default(cuid())
  clientId String
  name     String
  email    String?
  phone    String?
  designation String?
  isPrimary   Boolean @default(false)
  isDecisionMaker Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// Nightly snapshot of the health score with per-signal attribution, so
/// "why did this drop 12 points?" is always answerable.
model ClientHealthSnapshot {
  id       String @id @default(cuid())
  clientId String

  score              Int
  paymentScore       Int
  communicationScore Int
  approvalScore      Int
  deliveryScore      Int
  satisfactionScore  Int
  supportScore       Int
  engagementScore    Int

  signals    Json
  computedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, computedAt])
}

model Ticket {
  id             String @id @default(cuid())
  organizationId String
  clientId       String

  number      Int
  subject     String
  description String?
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)
  assigneeId  String?
  resolvedAt  DateTime?
  firstResponseAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PROJECTS
// ═══════════════════════════════════════════════════════════════════════════

model Project {
  id             String @id @default(cuid())
  organizationId String

  name        String
  code        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  services    ServiceType[]

  clientId  String?
  managerId String?

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  /// 0–100, recomputed from task completion on every task status change.
  progress Int @default(0)

  budget       Decimal? @db.Decimal(14, 2)
  /// Redacted from all but finance-visible roles.
  internalCost Decimal? @db.Decimal(14, 2)
  currency     String   @default("INR")

  /// Values keyed by CustomFieldDefinition.key for entityType 'Project'.
  customFields Json @default("{}")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  manager      User?        @relation("ProjectManager", fields: [managerId], references: [id])

  members        ProjectMember[]
  tasks          Task[]
  milestones     Milestone[]
  activities     Activity[]
  invoices       Invoice[]
  creativeBriefs CreativeBrief[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([clientId])
  @@index([managerId])
  @@index([dueDate])
}

model ProjectMember {
  id        String  @id @default(cuid())
  projectId String
  userId    String
  role      String?
  /// Percentage of this person's capacity committed to the project.
  allocation Int    @default(100)

  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime?
  completedAt DateTime?
  position  Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Task {
  id             String @id @default(cuid())
  organizationId String
  projectId      String

  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  priority    Priority   @default(MEDIUM)

  assigneeId  String?
  parentTaskId String?
  milestoneId String?

  dueDate        DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  estimatedHours Decimal? @db.Decimal(6, 2)

  /// Fractional position so a drag between two cards needs one UPDATE,
  /// not a renumber of the whole column.
  position Float @default(1000)

  labels        String[]
  /// When true the task appears in the client portal.
  clientVisible Boolean  @default(false)

  /// Values keyed by CustomFieldDefinition.key for entityType 'Task'.
  customFields Json @default("{}")

  isAiGenerated Boolean @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]       @relation("Subtasks")

  comments     TaskComment[]
  timeLogs     TimeLog[]
  dependencies TaskDependency[] @relation("DependentTask")
  blocking     TaskDependency[] @relation("BlockingTask")

  @@index([organizationId, deletedAt])
  @@index([organizationId, status, assigneeId])
  @@index([projectId, status, position])
  @@index([assigneeId, dueDate])
  @@index([parentTaskId])
}

model TaskDependency {
  id             String @id @default(cuid())
  /// The task that cannot start until `blockingTask` is done.
  dependentTaskId String
  blockingTaskId  String
  createdAt      DateTime @default(now())

  dependentTask Task @relation("DependentTask", fields: [dependentTaskId], references: [id], onDelete: Cascade)
  blockingTask  Task @relation("BlockingTask", fields: [blockingTaskId], references: [id], onDelete: Cascade)

  @@unique([dependentTaskId, blockingTaskId])
  @@index([blockingTaskId])
}

model TaskComment {
  id       String @id @default(cuid())
  taskId   String
  authorId String
  body     String
  /// User ids mentioned with @ — drives notification fan-out.
  mentions String[]
  isAiGenerated Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

model TimeLog {
  id       String @id @default(cuid())
  taskId   String
  userId   String
  minutes  Int
  note     String?
  loggedAt DateTime @default(now())
  billable Boolean  @default(true)

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId, loggedAt])
}

// ═══════════════════════════════════════════════════════════════════════════
//  CREATIVE PRODUCTION
// ═══════════════════════════════════════════════════════════════════════════

model CreativeBrief {
  id             String @id @default(cuid())
  organizationId String

  title       String
  type        CreativeType
  brief       String?
  status      String       @default("QUEUED")
  priority    Priority     @default(MEDIUM)

  clientId   String?
  projectId  String?
  assigneeId String?

  dueDate      DateTime?
  submittedAt  DateTime?
  deliveredAt  DateTime?

  revisionCount Int @default(0)
  revisionLimit Int @default(3)
  /// 1–5 quality rating recorded at delivery.
  rating        Int?
  /// Hours from brief creation to final delivery.
  turnaroundHours Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])
  assignee     User?        @relation("CreativeAssignee", fields: [assigneeId], references: [id])

  submissions CreativeSubmission[]
  approvals   Approval[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, type, status])
  @@index([assigneeId])
}

model CreativeSubmission {
  id      String @id @default(cuid())
  briefId String
  version Int
  fileUrl String?
  notes   String?
  submittedById String?

  createdAt DateTime @default(now())

  brief     CreativeBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  revisions Revision[]

  @@unique([briefId, version])
  @@index([briefId])
}

model Revision {
  id           String @id @default(cuid())
  submissionId String
  requestedById String?
  /// Whether the request came from the client or an internal reviewer.
  fromClient   Boolean @default(false)
  note         String
  /// Normalised x/y coordinates of the annotation pin, when applicable.
  pinX         Float?
  pinY         Float?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  submission CreativeSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model Approval {
  id             String @id @default(cuid())
  organizationId String

  /// Polymorphic target — 'CreativeBrief', 'Invoice', 'Quotation', …
  entityType String
  entityId   String

  status     ApprovalStatus @default(PENDING)
  approverId String?
  /// True when the client, not an internal reviewer, must decide.
  isClientApproval Boolean @default(false)

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  comment     String?

  briefId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approver     User?          @relation("ApprovalDecider", fields: [approverId], references: [id])
  brief        CreativeBrief? @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([approverId, status])
}

// ═══════════════════════════════════════════════════════════════════════════
//  FINANCE
// ═══════════════════════════════════════════════════════════════════════════

model Invoice {
  id             String @id @default(cuid())
  organizationId String

  number    String
  clientId  String
  projectId String?

  status   InvoiceStatus @default(DRAFT)
  issueDate DateTime     @default(now())
  dueDate  DateTime

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  discount   Decimal @default(0) @db.Decimal(14, 2)
  /// Intra-state supply splits into CGST + SGST; inter-state uses IGST.
  cgst       Decimal @default(0) @db.Decimal(14, 2)
  sgst       Decimal @default(0) @db.Decimal(14, 2)
  igst       Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @db.Decimal(14, 2)
  currency   String  @default("INR")

  notes String?
  terms String?

  sentAt   DateTime?
  viewedAt DateTime?
  paidAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id])
  project      Project?      @relation(fields: [projectId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, deletedAt])
  @@index([organizationId, status, dueDate])
  @@index([clientId])
}

model InvoiceItem {
  id          String       @id @default(cuid())
  invoiceId   String
  service     ServiceType?
  description String
  hsnSac      String?
  quantity    Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal      @db.Decimal(14, 2)
  taxRate     Decimal      @default(18) @db.Decimal(5, 2)
  amount      Decimal      @db.Decimal(14, 2)
  position    Int          @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  amount    Decimal       @db.Decimal(14, 2)
  currency  String        @default("INR")
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime      @default(now())
  note      String?

  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  createdById String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Expense {
  id             String @id @default(cuid())
  organizationId String

  title       String
  category    String
  description String?
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("INR")
  status      ExpenseStatus @default(DRAFT)
  incurredAt  DateTime      @default(now())
  receiptUrl  String?

  submittedById String?
  approvedById  String?
  approvedAt    DateTime?
  projectId     String?
  vendorId      String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
  @@index([submittedById])
}

model Vendor {
  id             String @id @default(cuid())
  organizationId String

  name      String
  category  String?
  email     String?
  phone     String?
  gstNumber String?
  bankDetails Json?
  /// Redacted from all but finance-visible roles.
  contractTerms String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  expenses Expense[]

  @@index([organizationId, deletedAt])
}

